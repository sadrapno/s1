{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "s1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b2633e8e-2a97-4b06-91a9-2c62cb693aaf","database_name": "S1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "51e0cf2e3d984fd8bc132d8b21efd269" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
